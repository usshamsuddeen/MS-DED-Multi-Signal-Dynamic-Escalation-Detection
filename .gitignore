# =====================================================
# .gitignore — MS-DED Research Repository
# =====================================================

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
*.tar.gz

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
.classpath
*.sublime-workspace
*.sublime-project

# OS-generated files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
*.lnk

# Manuscript files (not for public distribution)
*.docx
*.doc
*.pdf
*.odt

# Large model weights & data artifacts
*.pkl
*.pickle
*.h5
*.hdf5
*.pt
*.pth
*.safetensors
*.bin
*.onnx
*.npy
*.npz

# Logs & temporary files
*.log
*.tmp
*.bak
*.orig

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Environment variables
.env
.env.local
.env.production
